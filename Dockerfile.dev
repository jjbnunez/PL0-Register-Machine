FROM alpine:latest AS dev

# Set locale so Unicode characters render correctly in locale-aware tools (e.g. tmux)
ENV LANG=C.UTF-8

RUN apk add --no-cache \
	# Provides shell
	bash \
	# Provides text editor
	neovim \
	# Provides Lua interpreter
	lua5.5 \
	# Provides Lua language server
	lua-language-server \
	# Provides git command
	git \
	# Provides fzf command
	fzf \
	# Provides grep command
	grep \
	# Provides find command
	findutils \
	# Provides curl command
	curl \
	# Provides tree-sitter command
	tree-sitter

# Set up lua user
RUN addgroup -g 1000 lua \
	&& adduser -u 1000 -G lua -s /bin/bash -D lua

USER lua

WORKDIR /workspace

CMD ["bash"]
